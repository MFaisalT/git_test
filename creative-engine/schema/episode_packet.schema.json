{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "viral-character-lab/episode_packet/v1",
  "title": "EpisodePacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_version",
    "packet_id",
    "status",
    "brief",
    "bible_version",
    "evidence",
    "premises",
    "hook_variants",
    "selected",
    "script",
    "scenes",
    "continuity",
    "asset_rights",
    "tool_mapping",
    "approval",
    "export",
    "qa",
    "provenance",
    "negative_constraints"
  ],
  "properties": {
    "packet_version": {
      "const": "1.0"
    },
    "packet_id": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "enum": [
        "draft",
        "planning-ready; render unverified",
        "approved-for-render",
        "rendered-unverified",
        "rendered-verified",
        "rejected"
      ]
    },
    "brief": {
      "type": "object",
      "required": [
        "brief_id",
        "title",
        "format",
        "platform",
        "duration_target_s",
        "objective",
        "constraints"
      ],
      "properties": {
        "brief_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "bible_ref": {
          "type": "string"
        },
        "format": {
          "enum": [
            "silent_gag",
            "spoken_episode",
            "sponsored_episode",
            "serial_cliffhanger",
            "other"
          ]
        },
        "platform": {
          "enum": [
            "instagram_reels",
            "tiktok",
            "youtube_shorts",
            "multi"
          ]
        },
        "duration_target_s": {
          "type": "number",
          "minimum": 3,
          "maximum": 90
        },
        "language": {
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commercial": {
          "type": [
            "object",
            "null"
          ]
        },
        "negative_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "production_format": {
          "type": "object",
          "description": "fields the brief FIXES; omit a field to leave it open",
          "properties": {
            "shot_architecture": {
              "type": "string"
            },
            "audio_mode": {
              "type": "string"
            },
            "continuity_reuse": {
              "type": "object"
            },
            "camera_style": {
              "type": "string"
            }
          }
        },
        "render_tier": {
          "type": "string",
          "description": "Optional cost tier requested by the brief: draft_mini routes every <=15 s unit to Seedance 2.0 Mini for a cost-capped test render."
        }
      }
    },
    "bible_version": {
      "type": "object",
      "required": [
        "bible_id",
        "version"
      ],
      "properties": {
        "bible_id": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "kind",
          "source"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          },
          "source": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        }
      }
    },
    "premises": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "logline",
          "audience_emotion",
          "character_desire",
          "obstacle",
          "escalation",
          "surprise",
          "payoff",
          "structure",
          "why_send_it"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "logline": {
            "type": "string"
          },
          "audience_emotion": {
            "type": "string"
          },
          "character_desire": {
            "type": "string"
          },
          "obstacle": {
            "type": "string"
          },
          "escalation": {
            "type": "string"
          },
          "surprise": {
            "type": "string"
          },
          "payoff": {
            "type": "string"
          },
          "structure": {
            "type": "string"
          },
          "why_send_it": {
            "type": "string"
          },
          "commercial_fit": {
            "type": "string"
          },
          "rejected_because": {
            "type": "string"
          }
        }
      }
    },
    "hook_variants": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "premise_id",
          "first_frame",
          "first_line_or_action",
          "mechanism",
          "score",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "premise_id": {
            "type": "string"
          },
          "first_frame": {
            "type": "string"
          },
          "first_line_or_action": {
            "type": "string"
          },
          "mechanism": {
            "enum": [
              "curiosity_gap",
              "recognition",
              "visible_problem",
              "status_contradiction",
              "escalating_ritual",
              "callout",
              "other"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "selected": {
      "type": "object",
      "required": [
        "premise_id",
        "hook_id",
        "rationale"
      ],
      "properties": {
        "premise_id": {
          "type": "string"
        },
        "hook_id": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "script": {
      "type": "object",
      "required": [
        "title",
        "synopsis",
        "beats"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "synopsis": {
          "type": "string"
        },
        "beats": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "beat",
              "function"
            ],
            "properties": {
              "beat": {
                "type": "string"
              },
              "function": {
                "enum": [
                  "hook",
                  "setup",
                  "escalation",
                  "turn",
                  "payoff",
                  "button",
                  "cta"
                ]
              }
            }
          }
        },
        "dialogue": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "speaker",
              "line"
            ],
            "properties": {
              "speaker": {
                "type": "string"
              },
              "line": {
                "type": "string"
              },
              "delivery": {
                "type": "string"
              },
              "on_camera": {
                "type": "boolean"
              }
            }
          }
        },
        "caption_text": {
          "type": "string"
        },
        "cta": {
          "type": "string"
        },
        "disclosure_line": {
          "type": "string"
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scene_id",
          "start_s",
          "end_s",
          "location",
          "action",
          "performance",
          "microexpression",
          "camera",
          "lighting",
          "environment",
          "sound",
          "transition_out"
        ],
        "properties": {
          "scene_id": {
            "type": "string"
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "minimum": 0
          },
          "location": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "performance": {
            "type": "string"
          },
          "microexpression": {
            "type": "string"
          },
          "dialogue": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "speaker",
                "line"
              ],
              "properties": {
                "speaker": {
                  "type": "string"
                },
                "line": {
                  "type": "string"
                },
                "on_camera": {
                  "type": "boolean"
                },
                "delivery": {
                  "type": "string"
                }
              }
            }
          },
          "camera": {
            "type": "object",
            "required": [
              "shot",
              "lens",
              "movement"
            ],
            "properties": {
              "shot": {
                "type": "string"
              },
              "lens": {
                "type": "string"
              },
              "movement": {
                "type": "string"
              },
              "rig": {
                "type": "string"
              }
            }
          },
          "lighting": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "sound": {
            "type": "object",
            "required": [
              "ambience",
              "foley"
            ],
            "properties": {
              "ambience": {
                "type": "string"
              },
              "foley": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "music": {
                "type": "string"
              },
              "voice": {
                "type": "string"
              }
            }
          },
          "captions": {
            "type": "string"
          },
          "transition_out": {
            "type": "string"
          },
          "props_from_frame_one": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cuts_inside_clip": {
            "type": "integer",
            "minimum": 0
          },
          "generation_unit": {
            "type": "string"
          },
          "physical_beat": {
            "type": "string",
            "maxLength": 320,
            "description": "One sentence (<=40 words): who moves what, with which hand, the contact point, what holds still, and any world event the joke depends on. The compact render prompt sends only this plus dialogue."
          },
          "state_change_by_cut": {
            "type": "boolean",
            "description": "True when a prop's state change (cap off, dial moved, garment on) happens across the hard cut that opens this scene: the scene starts already in the end state, hands in the end pose."
          },
          "interaction": {
            "type": "object",
            "additionalProperties": false,
            "description": "One shown hand-object interaction (turn a dial, open a lid, peel a seal). The scene is its own generation unit, animated between an approved start keyframe and end keyframe (keyframe board, inspected by the owner before any video).",
            "required": ["actor_hand", "contact", "object", "part", "from_state", "to_state", "motion", "support_hand"],
            "properties": {
              "actor_hand": {"type": "string", "enum": ["left", "right", "both"]},
              "contact": {"type": "string", "description": "Exact contact point, e.g. 'right index fingertip on the pointer tip'."},
              "object": {"type": "string", "description": "Bible prop id or product id."},
              "part": {"type": "string", "description": "The moving part, e.g. 'pointer'."},
              "from_state": {"type": "string"},
              "to_state": {"type": "string"},
              "motion": {"type": "string", "description": "Path and speed, e.g. 'pushes the pointer tip slowly leftward; it pivots on the brass pin'."},
              "support_hand": {"type": "string", "description": "What the other hand does, e.g. 'left hand holds the handle still, board square to the lens'."},
              "keyframes": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "start": {"type": "string", "description": "job_id or media_id of the approved start frame"},
                  "end": {"type": "string", "description": "job_id or media_id of the approved end frame"},
                  "status": {"type": "string", "enum": ["planned", "generated_pending_owner_approval", "owner_approved"]}
                }
              }
            }
          }
        }
      }
    },
    "continuity": {
      "type": "object",
      "required": [
        "identity_anchors",
        "costume",
        "props",
        "notes"
      ],
      "properties": {
        "identity_anchors": {
          "type": "string"
        },
        "costume": {
          "type": "string"
        },
        "props": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "asset_rights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset",
          "kind",
          "source",
          "rights_status"
        ],
        "properties": {
          "asset": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "character_reference",
              "location_still",
              "voice",
              "music",
              "driving_footage",
              "product_image",
              "font",
              "other"
            ]
          },
          "source": {
            "type": "string"
          },
          "rights_status": {
            "enum": [
              "owned",
              "licensed",
              "consented",
              "unresolved",
              "not_needed"
            ]
          },
          "scope": {
            "type": "string"
          }
        }
      }
    },
    "tool_mapping": {
      "type": "object",
      "required": [
        "adapter",
        "verified_on",
        "units"
      ],
      "properties": {
        "adapter": {
          "type": "string"
        },
        "verified_on": {
          "type": "string"
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "generation_unit",
              "scene_ids",
              "model",
              "controls",
              "prompt_text",
              "manual_steps",
              "gaps"
            ],
            "properties": {
              "generation_unit": {
                "type": "string"
              },
              "scene_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "model": {
                "type": "string"
              },
              "controls": {
                "type": "object"
              },
              "prompt_text": {
                "type": "string"
              },
              "medias": {
                "type": "array"
              },
              "manual_steps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "gaps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "estimated_credits": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "quote_source": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "render_approved",
        "spend_approved",
        "publish_approved"
      ],
      "properties": {
        "render_approved": {
          "type": "boolean"
        },
        "spend_approved": {
          "type": "boolean"
        },
        "publish_approved": {
          "type": "boolean"
        },
        "approved_by": {
          "type": "string"
        },
        "approved_at": {
          "type": "string"
        },
        "credit_cap": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "export": {
      "type": "object",
      "required": [
        "aspect_ratio",
        "resolution",
        "fps",
        "container",
        "max_duration_s",
        "edit_plan"
      ],
      "properties": {
        "aspect_ratio": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        },
        "fps": {
          "type": "integer"
        },
        "container": {
          "type": "string"
        },
        "max_duration_s": {
          "type": "number"
        },
        "edit_plan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disclosure_plan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "qa": {
      "type": "object",
      "required": [
        "deterministic",
        "creative",
        "repetition"
      ],
      "properties": {
        "deterministic": {
          "type": "object"
        },
        "creative": {
          "type": "object"
        },
        "repetition": {
          "type": "object"
        },
        "render_inspection": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "growth_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "hypothesis",
          "metric",
          "falsifier"
        ],
        "properties": {
          "hypothesis": {
            "type": "string"
          },
          "metric": {
            "type": "string"
          },
          "falsifier": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "generated_at",
        "provider",
        "requested_model",
        "observed_model",
        "demonstrations_used",
        "stage_log"
      ],
      "properties": {
        "generated_at": {
          "type": "string"
        },
        "provider": {
          "enum": [
            "broker",
            "claude_cli",
            "fixture",
            "manual"
          ]
        },
        "requested_model": {
          "type": "string"
        },
        "observed_model": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        },
        "demonstrations_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trends_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trends_snapshot_age_days": {
          "type": [
            "number",
            "null"
          ]
        },
        "stage_log": {
          "type": "array"
        },
        "repair_passes": {
          "type": "integer"
        },
        "engine_version": {
          "type": "string"
        }
      }
    },
    "negative_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "production_format": {
      "type": "object",
      "required": [
        "shot_architecture",
        "audio_mode",
        "continuity_reuse",
        "rationale"
      ],
      "properties": {
        "shot_architecture": {
          "type": "string"
        },
        "audio_mode": {
          "type": "string"
        },
        "camera_style": {
          "type": "string"
        },
        "continuity_reuse": {
          "type": "object",
          "properties": {
            "voice": {
              "enum": [
                "same",
                "new",
                "none"
              ]
            },
            "location": {
              "enum": [
                "same",
                "new",
                "none"
              ]
            },
            "costume": {
              "enum": [
                "same",
                "new",
                "none"
              ]
            }
          }
        },
        "trend_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "string"
        },
        "chosen_by": {
          "enum": [
            "brief",
            "engine"
          ]
        },
        "soundtrack": {
          "type": "object",
          "description": "Required for audio_mode=music_driven. The track is laid in the edit; it is never generated by the video model.",
          "properties": {
            "source": {
              "enum": [
                "custom",
                "licensed",
                "owned",
                "platform_library"
              ]
            },
            "title": {
              "type": "string"
            },
            "rights_status": {
              "type": "string"
            },
            "bpm": {
              "type": "number",
              "minimum": 40,
              "maximum": 220
            },
            "beat_times_s": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "cue_length_s": {
              "type": "number"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}